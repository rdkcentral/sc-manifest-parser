<manifest>
  <default remote="external"/>
  <remote fetch="ssh://git@team.com" name="external" />
  <git_flow suffix="v2"/>
  <project groups="Group1" name="test_repo/repo_flow_test_projecta.git" path="dira" revision="donut">
    <annotation name="GIT_FLOW_SUFFIX" value="v2" />
  </project>
  <project groups="Group2" name="test_repo/repo_flow_test_projectb.git" path="dirb" revision="donut">
    <annotation name="GIT_FLOW_BRANCH_DEVELOP" value="develop_2" />
  </project>
  <project groups="Group3" name="test_repo/repo_flow_test_projectc.git" path="dirc" revision="donut">
    <annotation name="GIT_FLOW_BRANCH_MASTER" value="master_2" />
  </project>
  <project groups="Group4" name="test_repo/repo_flow_test_projectd.git" path="dird" revision="donut">
    <annotation name="GIT_LOCK_STATUS" value="READ_ONLY" />
    <linkfile dest="links" src="**" />
  </project>
  <post-sync path="post-sync.sh"/>
</manifest>
